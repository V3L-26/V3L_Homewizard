# Voorbeeld voor secrets.yaml - vul de echte waarden lokaal in Home Assistant
# in en commit dit bestand NOOIT met echte geheimen naar git.

supabase_anon_key: "sb_publishable_..."          # publishable/anon key van het Supabase-project
supabase_p1_key: "sb_publishable_..."             # meestal dezelfde publishable key als hierboven
supabase_p1_bearer: "Bearer sb_publishable_..."   # "Bearer " + dezelfde key (historisch, voor push_p1_naar_supabase)
supabase_login_payload: '{"email":"arjan@familievandriel.nl","password":"..."}'
